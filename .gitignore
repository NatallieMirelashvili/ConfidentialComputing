# Local/editor state
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# CC_Server
CC_Server/.pytest_cache/
CC_Server/**/__pycache__/
CC_Server/.venv/
CC_Server/server/certs/

# OP-TEE repo workspace generated by scripts/bootstrap.sh
.optee-workspace/

# Per-instance persistent device disk images (see docs/HANDOFF_persistentAK.md)
.device-state/

# Per-build stamp written by scripts/build.sh; scripts/run-project.sh diffs it
# to reset a device to a fresh TOFU on rebuild (docs/HANDOFF_serverAuthentication.md)
.build-stamp

# Google repo metadata and nested upstream git checkouts
.repo/
**/.repo/
**/.git/

# OP-TEE/buildroot/toolchain generated content
out/
out-br/
toolchains/
buildroot/dl/
qemu/build/
optee_os/out/
optee_ftpm/out/
trusted-firmware-a/build/
hafnium/build/
linux/tools/build/
u-boot/doc/build/
xen/automation/build/

# CMake and IDE build output
cmake-build-*/
**/cmake-build-*/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json

# Logs and generated binaries
*.log
*.o
*.a
*.so
*.elf
*.bin
*.img
*.rom
*.fd
*.dtb
*.cpio
*.uboot

# sensor_daemon: native, extensionless build output (see
